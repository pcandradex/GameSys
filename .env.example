# Copie para .env.local e preencha. Nunca commite o .env.local.

# ─── Banco de dados ──────────────────────────────────────────────────────────
# O dialeto é detectado pelo início da URL (ou force com DB_DIALECT=pg|mysql|sqlite).
#
# Postgres (Neon, Supabase, RDS, Railway, Render, Postgres próprio…):
#   DATABASE_URL=postgres://usuario:senha@host:5432/gamesys?sslmode=require
# MySQL / MariaDB (PlanetScale, RDS, Aiven, MySQL próprio…):
#   DATABASE_URL=mysql://usuario:senha@host:3306/gamesys
# SQLite local (arquivo) ou Turso (libSQL):
#   DATABASE_URL=file:./data/gamesys.db
#   DATABASE_URL=libsql://seu-banco.turso.io   (+ DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/gamesys.db
DATABASE_AUTH_TOKEN=
# Conexões por instância do app (pg/mysql). Em serverless, mantenha baixo
# e use o pooler do provedor (PgBouncer, Neon pooled URL etc.).
DB_POOL_SIZE=10

# ─── Autenticação (Better Auth) ──────────────────────────────────────────────
# Gere com: npx @better-auth/cli secret   (ou: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# URL pública do app (links de convite/recuperação e checagem de origem).
# Lida em runtime: o mesmo build pode rodar em domínios diferentes.
APP_URL=http://localhost:3000

# ─── Storage de imagens ──────────────────────────────────────────────────────
# local = pasta no disco do servidor (dev / VPS com disco persistente)
# s3    = qualquer S3-compatível: AWS S3, Cloudflare R2, MinIO, Backblaze B2…
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# S3_BUCKET=gamesys
# S3_REGION=auto
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com   (vazio para AWS)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   (true para MinIO)

# URL pública do bucket/CDN. Se vazio, as imagens são servidas pelo app em /files/*.
# STORAGE_PUBLIC_URL=https://cdn.seudominio.com

# ─── E-mail (convites e recuperação de senha) ────────────────────────────────
# Sem SMTP_HOST, o link é impresso no log do servidor (bom para dev).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# EMAIL_FROM=GameSys <no-reply@seudominio.com>

# ─── Steam ───────────────────────────────────────────────────────────────────
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
